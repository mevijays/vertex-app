project_id = "your-gcp-project-id"
region     = "asia-south1"

# Optional overrides
# service_account_id           = "vertex-gemini-client"
# service_account_display_name = "Vertex AI Gemini client"
# custom_role_id               = "vertexGeminiClient"
# custom_role_title            = "Vertex AI Gemini Client"

# Enable only when the application needs these capabilities.
enable_vision_permissions   = false
enable_gcs_read_permissions = false

# GKE cluster + Fleet + Managed Cloud Service Mesh (see main.tf).
gke_cluster_name = "vertex-chat-gke"
gke_zone         = "us-central1-a"
# gke_node_count          = 3
# gke_deletion_protection = true
